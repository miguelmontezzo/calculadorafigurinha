# Conexão do Neon (Vercel → Storage → Neon, ou console.neon.tech → Connect)
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.region.aws.neon.tech/calculadora3d?sslmode=require

# Segredo para assinar o cookie de login (gere um aleatório: openssl rand -hex 32)
AUTH_SECRET=troque-por-um-valor-aleatorio-longo

# Senha do painel /admin
ADMIN_SECRET=sua-senha-de-admin

# Hottok configurado no webhook da Hotmart
HOTMART_SECRET=seu_hottok_da_hotmart
