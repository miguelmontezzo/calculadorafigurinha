{
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/calculadora", "destination": "/calculadora.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "functions": {
    "api/hotmart-webhook.js": { "maxDuration": 10 },
    "api/import-members.js":  { "maxDuration": 10 },
    "api/login.js":           { "maxDuration": 10 }
  }
}
